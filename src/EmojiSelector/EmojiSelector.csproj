<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RootNamespace>EmojiSelector</RootNamespace>
  </PropertyGroup>

  <!-- The emoji list, by category, and the keywords in English and French: Emojibase's data (MIT), read by Data/EmojiCatalog. -->
  <!-- WithCulture="false": the .en / .fr in the names are not cultures, the data stays in the exe (no satellite assembly). -->
  <ItemGroup>
    <EmbeddedResource Include="Data\Emojibase\compact.en.json" LogicalName="EmojiSelector.Data.Emojibase.compact.en.json" WithCulture="false" />
    <EmbeddedResource Include="Data\Emojibase\compact.fr.json" LogicalName="EmojiSelector.Data.Emojibase.compact.fr.json" WithCulture="false" />
  </ItemGroup>

  <!-- The details panel's flags, 1× and 2× (public-domain designs), read by UI/EmojiDetailsPanel. -->
  <ItemGroup>
    <EmbeddedResource Include="UI\Flags\us.png" LogicalName="EmojiSelector.UI.Flags.us.png" WithCulture="false" />
    <EmbeddedResource Include="UI\Flags\us@2x.png" LogicalName="EmojiSelector.UI.Flags.us@2x.png" WithCulture="false" />
    <EmbeddedResource Include="UI\Flags\fr.png" LogicalName="EmojiSelector.UI.Flags.fr.png" WithCulture="false" />
    <EmbeddedResource Include="UI\Flags\fr@2x.png" LogicalName="EmojiSelector.UI.Flags.fr@2x.png" WithCulture="false" />
  </ItemGroup>

  <!-- dotnet publish -c Release: one small .exe, precompiled for fast startup; needs the .NET 10 Desktop Runtime. -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

</Project>
